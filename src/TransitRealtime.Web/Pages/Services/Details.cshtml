@page "{id:guid}"
@model TransitRealtime.Web.Pages.Services.DetailsModel
@{
    ViewData["Title"] = Model.Service.Name;
}

<h1>@Model.Service.Name</h1>
<p class="text-muted">@Model.Service.Description</p>

@if (!string.IsNullOrEmpty(Model.NewApiKey))
{
    <div class="alert alert-warning">
        <strong>Nouvelle clé API (webhook) — copie-la maintenant, elle ne sera plus jamais affichée :</strong>
        <pre class="mb-0">@Model.NewApiKey</pre>
    </div>
}

@if (!string.IsNullOrEmpty(Model.NewSubscriberSecret))
{
    <div class="alert alert-warning">
        <strong>Secret d'abonné (signe les tokens JoinChannel) — copie-le maintenant, il ne sera plus jamais affiché :</strong>
        <pre class="mb-0">@Model.NewSubscriberSecret</pre>
    </div>
}

<div class="row mb-4">
    <div class="col-md-8">
        <dl class="row">
            <dt class="col-sm-3">Statut</dt>
            <dd class="col-sm-9">
                @if (Model.Service.IsActive)
                {
                    <span class="badge bg-success">Actif</span>
                }
                else
                {
                    <span class="badge bg-secondary">Désactivé</span>
                }
            </dd>
            <dt class="col-sm-3">Clients connectés</dt>
            <dd class="col-sm-9">@Model.ConnectedClients</dd>
            <dt class="col-sm-3">Webhook URL</dt>
            <dd class="col-sm-9"><code>@Model.WebhookUrl</code></dd>
            <dt class="col-sm-3">Header requis</dt>
            <dd class="col-sm-9"><code>X-Api-Key: &lt;clé&gt;</code></dd>
            <dt class="col-sm-3">WebSocket (SignalR hub)</dt>
            <dd class="col-sm-9">
                <code>@Model.WsUrl</code>
                <ul class="mb-0">
                    <li>Diffusion large (tous les abonnés du service) : <code>JoinService("@Model.Service.Id")</code></li>
                    <li>
                        Ciblé par destinataire (recommandé si les payloads sont sensibles) :
                        <code>JoinChannel("@Model.Service.Id", "&lt;recipientKey&gt;", "&lt;token&gt;")</code>
                        — le <code>&lt;token&gt;</code> est un JWT HS256 signé avec le secret d'abonné ci-dessus,
                        claims <code>sub=&lt;recipientKey&gt;</code>, <code>svc=@Model.Service.Id</code>, courte durée de vie.
                        Webhook correspondant : <code>POST @Model.WebhookUrl/&lt;recipientKey&gt;</code>
                    </li>
                </ul>
            </dd>
        </dl>

        <form method="post" asp-page-handler="ToggleActive" class="d-inline">
            <button type="submit" class="btn btn-outline-secondary btn-sm">
                @(Model.Service.IsActive ? "Désactiver" : "Réactiver") le service
            </button>
        </form>
        <form method="post" asp-page-handler="RegenerateSubscriberSecret" class="d-inline">
            <button type="submit" class="btn btn-outline-secondary btn-sm">Régénérer le secret d'abonné</button>
        </form>
    </div>
</div>

<h2>Clés API</h2>
<form method="post" asp-page-handler="GenerateKey" class="mb-3">
    <button type="submit" class="btn btn-primary btn-sm">+ Générer une nouvelle clé</button>
</form>

<table class="table table-sm">
    <thead>
        <tr>
            <th>Préfixe</th>
            <th>Créée le</th>
            <th>Statut</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var key in Model.Service.ApiKeys.OrderByDescending(k => k.CreatedAt))
    {
        <tr>
            <td><code>@key.KeyPrefix…</code></td>
            <td>@key.CreatedAt.ToLocalTime().ToString("g")</td>
            <td>
                @if (key.IsActive)
                {
                    <span class="badge bg-success">Active</span>
                }
                else
                {
                    <span class="badge bg-secondary">Révoquée</span>
                }
            </td>
            <td>
                @if (key.IsActive)
                {
                    <form method="post" asp-page-handler="RevokeKey" asp-route-keyId="@key.Id">
                        <button type="submit" class="btn btn-outline-danger btn-sm">Révoquer</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>

<h2>Activité récente</h2>
<table class="table table-sm">
    <thead>
        <tr>
            <th>Date</th>
            <th>Événement</th>
            <th>IP source</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var log in Model.RecentLogs)
    {
        <tr>
            <td>@log.Timestamp.ToLocalTime().ToString("g")</td>
            <td>@log.EventType</td>
            <td>@log.SourceIp</td>
        </tr>
    }
    </tbody>
</table>

<a asp-page="Index">&larr; Retour à la liste</a>
