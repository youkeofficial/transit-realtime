@page
@model TransitRealtime.Web.Pages.Services.IndexModel
@{
    ViewData["Title"] = "Services";
}

<h1>Services</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">+ Nouveau service</a>
</p>

@if (Model.Rows.Count == 0)
{
    <p class="text-muted">Aucun service pour l'instant.</p>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Statut</th>
                <th>Clés actives</th>
                <th>Clients connectés</th>
                <th>Créé le</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var row in Model.Rows)
        {
            <tr>
                <td>@row.Service.Name</td>
                <td>
                    @if (row.Service.IsActive)
                    {
                        <span class="badge bg-success">Actif</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Désactivé</span>
                    }
                </td>
                <td>@row.ActiveKeyCount</td>
                <td>@row.ConnectedClients</td>
                <td>@row.Service.CreatedAt.ToLocalTime().ToString("g")</td>
                <td><a asp-page="Details" asp-route-id="@row.Service.Id">Détails</a></td>
            </tr>
        }
        </tbody>
    </table>
}
