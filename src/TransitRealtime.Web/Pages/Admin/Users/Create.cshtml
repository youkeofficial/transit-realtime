@page
@model TransitRealtime.Web.Pages.Admin.Users.CreateModel
@{
    ViewData["Title"] = "Nouveau compte admin";
}

<h1>Nouveau compte admin</h1>

@if (TempData["StatusMessage"] is string status)
{
    <div class="alert alert-success">@status</div>
}

<form method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Input.Email" class="form-label">Email</label>
        <input asp-for="Input.Email" class="form-control" />
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Password" class="form-label">Mot de passe</label>
        <input asp-for="Input.Password" class="form-control" />
        <span asp-validation-for="Input.Password" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Créer</button>
</form>
